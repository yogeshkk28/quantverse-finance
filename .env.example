# =========================================================================
# LUMINA QUANT TERMINAL - ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# Web Server Ingress Configuration
# -------------------------------------------------------------------------
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------------
# Artificial Intelligence Setup
# -------------------------------------------------------------------------
# Required for live LLM-powered market analysis and quant strategist reports.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# -------------------------------------------------------------------------
# Stocks Listing & Real-time Quotes Service
# -------------------------------------------------------------------------
# Optional. Real-time US quotes from Finnhub (free plan: 60 calls/min, US only).
# Without it, prices come from Yahoo Finance (delayed, no key needed) for US and NSE.
FINNHUB_API=""

# -------------------------------------------------------------------------
# Key Valuation & Corporate Fundamentals
# -------------------------------------------------------------------------
# Provide Financial Modeling Prep API Key to fetch dynamic PE, ROE and market cap.
# Uses FMP's /stable/ endpoints. Free plan: 250 calls/day, US stocks only (cached 12h).
FINANCIAL_MODELING_API=""

# -------------------------------------------------------------------------
# Historical Analytics & Candlestick Charts
# -------------------------------------------------------------------------
# Provide AlphaVantage API Key to fetch live 30-day historical candle bars.
ALPHA_VANTAGE_A=""

# -------------------------------------------------------------------------
# Financial & Corporate Media News Feeds
# -------------------------------------------------------------------------
# Provide NewsData.io (news.io) API key to load live world finance articles.
NEWS_IO_API=""

# -------------------------------------------------------------------------
# Macroeconomic Indicators (FRED Series)
# -------------------------------------------------------------------------
# FRED key for the macro strip and the junk-bond input of the Fear & Greed index.
FRED_API=""

# -------------------------------------------------------------------------
# Sentiment Indices
# -------------------------------------------------------------------------
# The stock Fear & Greed index is computed in server/fearGreed.ts from Yahoo + FRED data.
# Alternative.me's crypto index is shown alongside it and needs no key.
